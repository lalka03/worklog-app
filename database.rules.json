{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "profile": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.hasChildren(['email']) && newData.child('email').isString() && newData.child('email').val() === auth.token.email",
          "email": {".validate": "newData.isString()"},
          "$other": {".validate": false}
        },
        "worklog": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['settings', 'version', 'updatedAt']) && newData.child('version').val() === 1 && newData.child('updatedAt').isNumber()"
        }
      }
    }
  }
}
